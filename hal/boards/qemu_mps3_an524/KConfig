config BOARD_QEMU_MPS3_AN524
  bool "QEMU MPS3-AN524 (Cortex-M33, SSE-200)"

if BOARD_QEMU_MPS3_AN524
  config CONFIG_BOARD
    def_string "qemu_mps3_an524"

  choice CHOICE_CPU
    default CPU_QEMU_MPS3
  endchoice

  config CONFIG_BUILD_LINKER_SCRIPT_PATH
    default "${hal_root}/source/arm/qemu_mps3/linker_script.ld"

  config FLASH_MEMORY_ADDRESS
    default "0x10000000"

  config FLASH_MEMORY_SIZE
    default "512K"
endif
