config BOARD_PIMORONI_PICO_PLUS2_DISCARD_IN_CONF
  bool "Pimoroni Pico Plus 2"

if BOARD_PIMORONI_PICO_PLUS2_DISCARD_IN_CONF
  config CONFIG_BOARD
    def_string "pimoroni_pico_plus2"

  choice CHOICE_CPU
    default CPU_RP2350
  endchoice

  choice CONFIG_PROCESS_SCHEDULER
    default CONFIG_SCHEDULER_ROUND_ROBIN
  endchoice

  config CONFIG_BUILD_LINKER_SCRIPT_PATH
    default "${hal_root}/source/raspberry/rp2350/linker_script.ld"

  config FLASH_MEMORY_ADDRESS
    default "0x10000000"

  config FLASH_MEMORY_SIZE
    default "16MB"

  config CONFIG_PSRAM_CS_PIN
    default 47

  config CONFIG_CPU_CLOCK_FREQUENCY_MHZ
    default 618

  config CONFIG_FLASH_XIP_MAX_FREQUENCY_HZ
    default 133000000

  config CONFIG_FLASH_XIP_MAX_SELECT_US
    default 8

  config CONFIG_PSRAM_MAX_FREQUENCY_HZ
    # APS6404L spec ceiling (~133 MHz SCK). The previous 84 MHz cap worked
    # around pagebreak=NONE, where QMI ran one linear burst across page
    # boundaries toward the tCEM limit; QMI M1 timing now uses pagebreak=1024
    # (external_memory.zig), which breaks bursts at the page boundary and keeps
    # them in spec, so the cap is no longer needed. Note: at clkdiv = max(2,
    # ceil(sysclk/this)), SCK == sysclk/2 == 75 MHz at the 150 MHz sysclk either
    # way; this ceiling only raises SCK when the CPU is overclocked higher.
    default 133000000

  config CONFIG_PSRAM_CE_MAX_LOW_US
    default 8

  config CONFIG_PSRAM_CE_MIN_DESELECT_NS
    default 50

  config CONFIG_PSRAM_RXDELAY_LO
    default 2

  config CONFIG_PSRAM_RXDELAY_HI
    default 3

  config CONFIG_PSRAM_RXDELAY_HI_FREQ_THRESHOLD_HZ
    default 90000000

  config CONFIG_BUILD_USE_NEWLIB
    default y

  choice CONFIG_MMC_BUS_MODE
    default CONFIG_MMC_BUS_MODE_SDIO
  endchoice

endif
