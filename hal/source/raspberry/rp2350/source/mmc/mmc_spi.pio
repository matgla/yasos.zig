.program mmc_spi_transmit
.side_set 1
.wrap_target
    out pins, 1 side 0 
    in pins, 1 side 1 
.wrap

% c-sdk {

#include "hardware/gpio.h"

static inline void pio_mmc_spi_transmit_init(PIO pio, uint sm, uint program_offset, float clkdiv, uint pin_sck, uint pin_mosi, uint pin_miso) {
    pio_sm_config c = mmc_spi_transmit_program_get_default_config(program_offset);
    sm_config_set_out_pins(&c, pin_mosi, 1);
    sm_config_set_in_pins(&c, pin_miso);
    sm_config_set_sideset_pins(&c, pin_sck);
    
    sm_config_set_out_shift(&c, false, true, 8);
    sm_config_set_in_shift(&c, false, true, 8);
    sm_config_set_clkdiv(&c, clkdiv);

    pio_sm_set_pins_with_mask64(pio, sm, 0ul, (1ull << pin_sck) | (1ull << pin_mosi));
    pio_sm_set_pindirs_with_mask64(pio, sm, (1ull << pin_sck) | (1ull << pin_mosi), (1ull << pin_sck) | (1ull << pin_mosi) | (1ull << pin_miso));

    pio_gpio_init(pio, pin_sck);
    pio_gpio_init(pio, pin_mosi);
    pio_gpio_init(pio, pin_miso);

    gpio_set_slew_rate(pin_sck, GPIO_SLEW_RATE_FAST);
    gpio_set_slew_rate(pin_mosi, GPIO_SLEW_RATE_FAST);
    gpio_set_slew_rate(pin_miso, GPIO_SLEW_RATE_FAST);

    gpio_set_drive_strength(pin_sck, GPIO_DRIVE_STRENGTH_2MA);
    gpio_set_drive_strength(pin_mosi, GPIO_DRIVE_STRENGTH_2MA);
    gpio_set_drive_strength(pin_miso, GPIO_DRIVE_STRENGTH_2MA);

    hw_set_bits(&pio->input_sync_bypass, 1u << (pin_miso % 32));

    pio_sm_init(pio, sm, program_offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
% zig {
/// pio_mmc_spi_transmit_init from the c-sdk block above, for Zig: `sdk` is the
/// translated SDK headers (hardware/pio.h, hardware/gpio.h).
pub fn pio_mmc_spi_transmit_init(comptime sdk: type, pio: sdk.PIO, sm: c_uint, program_offset: c_uint, clkdiv: f32, pin_sck: c_uint, pin_mosi: c_uint, pin_miso: c_uint) void {
    var c = mmc_spi_transmit_program_get_default_config(sdk, program_offset);
    sdk.sm_config_set_out_pins(&c, pin_mosi, 1);
    sdk.sm_config_set_in_pins(&c, pin_miso);
    sdk.sm_config_set_sideset_pins(&c, pin_sck);

    sdk.sm_config_set_out_shift(&c, false, true, 8);
    sdk.sm_config_set_in_shift(&c, false, true, 8);
    sdk.sm_config_set_clkdiv(&c, clkdiv);

    const sck = @as(c_ulonglong, 1) << @intCast(pin_sck);
    const mosi = @as(c_ulonglong, 1) << @intCast(pin_mosi);
    const miso = @as(c_ulonglong, 1) << @intCast(pin_miso);
    sdk.pio_sm_set_pins_with_mask64(pio, sm, 0, sck | mosi);
    sdk.pio_sm_set_pindirs_with_mask64(pio, sm, sck | mosi, sck | mosi | miso);

    sdk.pio_gpio_init(pio, pin_sck);
    sdk.pio_gpio_init(pio, pin_mosi);
    sdk.pio_gpio_init(pio, pin_miso);

    sdk.gpio_set_slew_rate(pin_sck, sdk.GPIO_SLEW_RATE_FAST);
    sdk.gpio_set_slew_rate(pin_mosi, sdk.GPIO_SLEW_RATE_FAST);
    sdk.gpio_set_slew_rate(pin_miso, sdk.GPIO_SLEW_RATE_FAST);

    sdk.gpio_set_drive_strength(pin_sck, sdk.GPIO_DRIVE_STRENGTH_2MA);
    sdk.gpio_set_drive_strength(pin_mosi, sdk.GPIO_DRIVE_STRENGTH_2MA);
    sdk.gpio_set_drive_strength(pin_miso, sdk.GPIO_DRIVE_STRENGTH_2MA);

    sdk.hw_set_bits(&pio.*.input_sync_bypass, @as(c_uint, 1) << @intCast(pin_miso % 32));

    _ = sdk.pio_sm_init(pio, sm, program_offset, &c);
    sdk.pio_sm_set_enabled(pio, sm, true);
}
%}
