mainmenu "Yet Another Simple Operating System"

source "./hal/KConfig"

menu "Process Options"

config CONFIG_PROCESS_USE_MPU_STACK_PROTECTION
  bool "Use MPU Stack Protection"
  help
    Use hardware unit for stack protection of process
  depends on CPU_HAS_MPU

config CONFIG_PROCESS_USE_MPU_KERNEL_PROTECTION
  bool "Protect kernel heap and stack with the MPU"
  default y
  depends on CPU_HAS_MPU
  help
    Configure the MPU at boot so that unprivileged user processes cannot access
    the kernel heap or the kernel stack. The kernel keeps full access through the
    privileged background memory map; user processes run unprivileged and may only
    touch code (flash), the romfs image and the user RAM pool. An unprivileged
    access to kernel memory faults and terminates the offending process.

    Per-process isolation (a process restricted to only its own memory) is not
    provided: PMSAv8 has no sub-regions and only 8 regions, while a process
    accumulates ~12 scattered page allocations, so its memory cannot be covered
    by static regions. This option protects the kernel only.

config CONFIG_PROCESS_USE_STACK_OVERFLOW_DETECTION
  bool "Use stack overflow detection"
  default y
  help
    Software stack overflow detection.
    This is detection, not prevention. If stack overflow occured memory may be corrupted!
    For prevention MPU must be used in hardware's that supports it.

config CONFIG_PROCESS_CONTEXT_SWITCH_PERIOD
  int "Context switch period in milliseconds"
  default 20
  help
    Context switch period in milliseconds, process may be interrupted earlier if blocked on IO

config CONFIG_PROCESS_DEFAULT_STACK_SIZE
  int "Default process stack size"
  default 32768
  help
    Default stack size for newly spawned processes, including the root process.

config CONFIG_PROCESS_MAX_STACK_SIZE
  int "Maximum process stack size"
  default 1048576
  help
    Hard stack size limit for processes. Soft stack limits may be raised up to
    this value.

config CONFIG_PROCESS_SMP
  bool "Run the scheduler on more than one core"
  default n
  help
    Whether a second core is actually brought up and scheduled on.

    This is NOT "does the chip have two cores" -- the RP2350 does, and reports
    it through hal.cpu.number_of_cores(), while YasOS still parks core 1. It is
    "is more than one core running kernel code", which is what decides whether
    cross-core synchronization has anything to do.

    With this off, the kernel keeps every atomic and every interrupt mask it has
    -- the scheduler is preemptive, so a read-modify-write shared between thread
    and handler context still races on a single core -- but drops the parts that
    only mean something between cores: the spinlock's wait/wake back-off, and
    the per-CPU arrays collapse to one slot with a compile-time-zero index.

    Turn it on with core 1 bring-up (phase 6 of docs/smp_plan.md), and on the
    host unit-test target, where the primitives are exercised under genuine
    std.Thread contention.

choice CONFIG_PROCESS_SCHEDULER
  prompt "Process Scheduler"
  help
    Select process scheduler to use.
    Round Robin scheduler is a simple scheduler that allows processes to run for a fixed time slice.
    OSThread scheduler is a stub scheduler that uses OS thread to simulate processes
config CONFIG_SCHEDULER_OSTHREAD
  bool "OSThread"
config CONFIG_SCHEDULER_ROUND_ROBIN
  bool "RoundRobinScheduler"
config CONFIG_SCHEDULER_STUB
  bool "StubScheduler"
endchoice

config CONFIG_PROCESS_MAX_PID_VALUE
  int "Max PID value"
  default 2048
  help
    Maximum PID value, after reaching this value PID will wrap around to 1

endmenu

menu "Logging & Instrumentation"
  config CONFIG_INSTRUMENTATION_ENABLE_MEMORY_LEAK_DETECTION
    prompt "Enable leak detection"
    def_bool "false"
  config CONFIG_INSTRUMENTATION_LEAK_REPORT_DEAD_ONLY
    prompt "Report leaks only from dead processes"
    def_bool "true"
    depends on CONFIG_INSTRUMENTATION_ENABLE_MEMORY_LEAK_DETECTION
  config CONFIG_INSTRUMENTATION_VERBOSE_ALLOCATORS
    prompt "Enable verbose kernel allocator"
    def_bool "false"
  config CONFIG_INSTRUMENTATION_PRINT_MEMORY_USAGE
    prompt "Enable kernel allocator memory usage"
    def_bool "false"

  config CONFIG_INSTRUMENTATION_PERF_PROFILING
    prompt "Enable performance profiling"
    def_bool "false"
    help
      Enable per-syscall cycle counting and performance profiling.
      When enabled the kernel accumulates DWT cycle counts per syscall type
      and exposes a sys_perf_dump syscall to retrieve the results.
      TCC will also emit a detailed bench breakdown when this is active.

  config CONFIG_INSTRUMENTATION_LOG_TO_SD
    prompt "Mirror kernel log to SD card (/root/logs)"
    def_bool "false"
    help
      Mirror every kernel log line to /root/logs/kernel.log on the SD card
      (rotating the previous boot to kernel.prev.log), in addition to the
      serial console. Only takes effect when /root is the MMC-backed rootfs.

      EXPERIMENTAL / may be unstable: the mirror writes synchronously from the
      logging context, and the RP2350 SDIO driver (PIO+DMA, non-reentrant) can
      bus-fault when driven from arbitrary log contexts (e.g. the dynamic
      loader). Leave disabled unless you are actively debugging and accept the
      risk; the serial console captures the same lines safely.

  choice "Log level"
    prompt "Log level"
    config CONFIG_INSTRUMENTATION_LOG_ERROR
      bool "error"
    config CONFIG_INSTRUMENTATION_LOG_WARNING
      bool "warning"
    config CONFIG_INSTRUMENTATION_LOG_INFO
      bool "info"
    config CONFIG_INSTRUMENTATION_LOG_DEBUG
      bool "debug"
 endchoice
endmenu

menu "Filesystem Options"
  rsource "source/fs/KConfig"

endmenu
