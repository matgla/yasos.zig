{
  "$comment": "The yasc dialect of tinycc, injected into VSCode's C grammar. yasc is tcc's default dialect, so it applies to every C file; there is no parser, so each word is a keyword only where tcc would take it as one, guessed from its neighbours (tcc parses these words as names elsewhere). The same rules as yasvi's filetypes/c.c; test/run.js checks them.",
  "scopeName": "source.c.yasc",
  "injectionSelector": "L:source.c -comment -string",
  "patterns": [
    {
      "include": "#module"
    },
    {
      "include": "#qualifier-with-list"
    },
    {
      "include": "#qualifier-after-star"
    },
    {
      "include": "#qualifier-in-brackets"
    },
    {
      "include": "#qualifier-after-type"
    },
    {
      "include": "#qualifier-before-type"
    },
    {
      "include": "#statement"
    },
    {
      "include": "#cast"
    },
    {
      "include": "#unsafe"
    },
    {
      "include": "#try"
    },
    {
      "include": "#catch"
    },
    {
      "include": "#unreachable"
    },
    {
      "include": "#error-set"
    },
    {
      "include": "#error-value"
    },
    {
      "include": "#error-type"
    },
    {
      "include": "#error-builtin"
    },
    {
      "include": "#ownership-operator"
    },
    {
      "include": "#error-union"
    },
    {
      "include": "#slice-type"
    },
    {
      "include": "#slice-colon"
    },
    {
      "include": "#tagged-union"
    },
    {
      "include": "#register-field"
    },
    {
      "include": "#c23"
    },
    {
      "include": "#at-builtin"
    }
  ],
  "repository": {
    "module": {
      "$comment": "module a.b; import a.b; export DECL -- at the start of a file-scope declaration",
      "patterns": [
        {
          "match": "^\\s*(module|import)\\s+([A-Za-z_][\\w.]*)\\s*(?=;)",
          "captures": {
            "1": {
              "name": "keyword.control.import.yasc.c"
            },
            "2": {
              "name": "entity.name.namespace.yasc.c"
            }
          }
        },
        {
          "match": "^\\s*(export)\\b(?=\\s+[A-Za-z_])",
          "captures": {
            "1": {
              "name": "storage.modifier.export.yasc.c"
            }
          }
        }
      ]
    },
    "qualifier-after-star": {
      "$comment": "owned / view / maybe qualify a pointer: they follow its '*' (or another qualifier): char * owned maybe p, const char * view * view argv, f(char * view), FILE * owned(fclose) maybe f",
      "match": "(?<=\\*\\s*|\\b(?:owned|view|maybe)\\s+|\\b(?:owned|borrows|takes|c_api)\\s*\\([^()]*\\)\\s*)(owned|view|maybe)\\b(?=\\s*(?:[A-Za-z_*),]|$))",
      "name": "storage.modifier.yasc.c"
    },
    "qualifier-before-type": {
      "$comment": "out / inout / in / drop come before a parameter's type: out int * view n, inout FILE * view f, drop struct s * owned p",
      "match": "(?<!\\.|->)\\b(out|inout|in|drop)\\b(?=\\s+[A-Za-z_])",
      "name": "storage.modifier.yasc.c"
    },
    "statement": {
      "match": "(?<!\\.|->)\\b(defer|errdefer)\\b(?=\\s*(?:[A-Za-z_*{(]|$))",
      "name": "keyword.control.defer.yasc.c"
    },
    "unreachable": {
      "$comment": "unreachable is an expression of its own: unreachable;, default: unreachable;, f() catch unreachable -- first on its line, after ; { } : ), else or catch, and before ; , ) or }; not a name being declared (int unreachable;), called or assigned",
      "match": "(?:^|(?<=[;{}:)])|(?<=\\belse|\\bcatch)(?=\\s))\\s*\\b(unreachable)\\b(?=\\s*[;,)}])",
      "captures": {
        "1": {
          "name": "keyword.control.unreachable.yasc.c"
        }
      }
    },
    "try": {
      "match": "(?<!\\.|->)\\btry\\b(?=\\s*[A-Za-z_(*&])",
      "name": "keyword.control.try.yasc.c"
    },
    "catch": {
      "$comment": "f() catch X, f() catch |e| {...}: catch follows the end of an expression, starts a continuation line, or comes before |e| or {",
      "patterns": [
        {
          "match": "(?<=[)\\]\\\"']|[\\w)\\]\\\"'] |[\\w)\\]\\\"']  |[\\w)\\]\\\"']\\t)\\b(catch)\\b(?=\\s*[^\\s;,=)\\].:])(?:\\s*(\\|)\\s*([A-Za-z_]\\w*)\\s*(\\|))?",
          "captures": {
            "1": {
              "name": "keyword.control.catch.yasc.c"
            },
            "2": {
              "name": "punctuation.definition.capture.begin.yasc.c"
            },
            "3": {
              "name": "variable.parameter.capture.yasc.c"
            },
            "4": {
              "name": "punctuation.definition.capture.end.yasc.c"
            }
          }
        },
        {
          "match": "(?<!\\.|->)\\b(catch)\\b(?=\\s*[|{])(?:\\s*(\\|)\\s*([A-Za-z_]\\w*)\\s*(\\|))?",
          "captures": {
            "1": {
              "name": "keyword.control.catch.yasc.c"
            },
            "2": {
              "name": "punctuation.definition.capture.begin.yasc.c"
            },
            "3": {
              "name": "variable.parameter.capture.yasc.c"
            },
            "4": {
              "name": "punctuation.definition.capture.end.yasc.c"
            }
          }
        },
        {
          "match": "^\\s*(catch)\\b(?=\\s*[^\\s;,=)\\].:(])(?:\\s*(\\|)\\s*([A-Za-z_]\\w*)\\s*(\\|))?",
          "captures": {
            "1": {
              "name": "keyword.control.catch.yasc.c"
            },
            "2": {
              "name": "punctuation.definition.capture.begin.yasc.c"
            },
            "3": {
              "name": "variable.parameter.capture.yasc.c"
            },
            "4": {
              "name": "punctuation.definition.capture.end.yasc.c"
            }
          }
        }
      ]
    },
    "error-set": {
      "$comment": "error ParseError { Empty, BadDigit = 7, EACCES };",
      "begin": "(?<!\\.|->)\\b(error)\\s+([A-Za-z_]\\w*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.error.yasc.c"
        },
        "2": {
          "name": "entity.name.type.error.yasc.c"
        },
        "3": {
          "name": "punctuation.section.block.begin.bracket.curly.c"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.bracket.curly.c"
        }
      },
      "patterns": [
        {
          "include": "source.c#comments"
        },
        {
          "match": "\\b[A-Za-z_]\\w*\\b",
          "name": "constant.other.error.yasc.c"
        },
        {
          "include": "source.c#numbers"
        },
        {
          "match": ",",
          "name": "punctuation.separator.delimiter.c"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.c"
        }
      ]
    },
    "error-value": {
      "$comment": "error.NAME",
      "match": "(?<!\\.|->)\\b(error)(\\.)([A-Z]\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.error.yasc.c"
        },
        "2": {
          "name": "punctuation.separator.dot-access.c"
        },
        "3": {
          "name": "constant.other.error.yasc.c"
        }
      }
    },
    "error-type": {
      "$comment": "error ParseError pe, error any (any error), error ParseError on a line of its own",
      "match": "(?<!\\.|->)\\b(error)\\b(?=\\s+[A-Za-z_])(?:\\s+([A-Za-z_]\\w*)(?=\\s*(?:[A-Za-z_*]|$)))?",
      "captures": {
        "1": {
          "name": "storage.type.error.yasc.c"
        },
        "2": {
          "name": "entity.name.type.error.yasc.c"
        }
      }
    },
    "error-builtin": {
      "match": "(?<!\\.|->)\\b(error_name|error_from)\\b(?=\\s*\\()",
      "name": "support.function.yasc.c"
    },
    "ownership-operator": {
      "$comment": "move(x) / borrow(x): operators like sizeof, not calls -- support.function would color them as any function name",
      "match": "(?<!\\.|->)\\b(?:(move)|(borrow))\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.operator.expression.move.yasc.c"
        },
        "2": {
          "name": "keyword.operator.expression.borrow.yasc.c"
        }
      }
    },
    "error-union": {
      "$comment": "!T, a T or an error: '!' before a type (no expression puts one there), or before NAME NAME( -- a function returning !typedef_t",
      "patterns": [
        {
          "match": "!(?=\\s*(?:void|char|short|int|long|float|double|signed|unsigned|_Bool|bool|struct|union|enum|const|volatile|u?int(?:8|16|32|64|ptr)_t|s?size_t)\\b)",
          "name": "storage.modifier.errunion.yasc.c"
        },
        {
          "match": "!(?=\\s*(?!sizeof\\b|defined\\b|return\\b)[A-Za-z_]\\w*(?:\\s*\\*\\s*(?:(?:owned|view|maybe)\\b\\s*|(?:owned|borrows|takes|c_api)\\s*\\([^()]*\\)\\s*)*)*\\s+[A-Za-z_]\\w*\\s*\\()",
          "name": "storage.modifier.errunion.yasc.c"
        }
      ]
    },
    "qualifier-with-list": {
      "$comment": "owned(dealloc) / borrows(x, ...) / takes(p): after a '*' or another qualifier, or after a type when the declaration goes on: FILE * owned(fclose) maybe f, int owned(close) maybe fd, regex_t owned(regfree) re, struct tokenizer borrows(text) {",
      "patterns": [
        {
          "match": "(?<=\\*\\s*|\\b(?:owned|view|maybe)\\s+|\\b(?:owned|borrows|takes|c_api)\\s*\\([^()]*\\)\\s*)(?<!\\.|->)\\b(owned|borrows|takes|c_api)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "storage.modifier.yasc.c"
            }
          }
        },
        {
          "match": "(?<=\\b[A-Za-z_]\\w*\\s+)(?<!\\b(?:struct|union|enum|typedef|const|volatile|static|extern|register|inline|restrict|return|case|goto|else|do|sizeof|typeof|alignof|if|while|for|switch|break|continue|default)\\s+)(?<![.>]\\s*\\b\\w+\\s+)\\b(owned|borrows)\\s*(?=\\([^()]*\\)\\s*(?:[A-Za-z_*{]|$))",
          "captures": {
            "1": {
              "name": "storage.modifier.yasc.c"
            }
          }
        }
      ]
    },
    "qualifier-after-type": {
      "$comment": "int handles: int view fd, pid_t view p -- after a type name, before the declared name",
      "match": "(?<=\\b[A-Za-z_]\\w*\\s+)(?<!\\b(?:struct|union|enum|typedef|const|volatile|static|extern|register|inline|restrict|return|case|goto|else|do|sizeof|typeof|alignof|if|while|for|switch|break|continue|default)\\s+)(?<![.>]\\s*\\b\\w+\\s+)\\b(view|maybe)\\b(?=\\s+[A-Za-z_])",
      "name": "storage.modifier.yasc.c"
    },
    "unsafe": {
      "$comment": "unsafe { ... } and unsafe(expr): the strict lifetime errors are not said there",
      "match": "(?<!\\.|->)\\bunsafe\\b(?=\\s*[{(])",
      "name": "keyword.control.unsafe.yasc.c"
    },
    "tagged-union": {
      "$comment": "long i when(V_INT); in a tagged union union(k) { ... }: after a member declarator",
      "match": "(?<=[\\w\\]]\\s+)(?<!\\b(?:struct|union|enum|typedef|const|volatile|static|extern|register|inline|restrict|return|case|goto|else|do|sizeof|typeof|alignof|if|while|for|switch|break|continue|default)\\s+)\\b(when)\\b(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "storage.modifier.when.yasc.c"
        }
      }
    },
    "register-field": {
      "$comment": "register fields: uint32_t irq:1 w1c; volatile uint32_t id ro; -- after a member's declarator: a name after a type (not int ro; struct s ro; return ro;), *p, a bit-field width or an array",
      "match": "(?:(?<=\\]\\s+)|(?<=:\\s*\\d\\w*\\s+)|(?<=\\*\\s*[A-Za-z_]\\w*\\s+)|(?<=\\b[A-Za-z_]\\w*\\s+[A-Za-z_]\\w*\\s+)(?<!\\b(?:struct|union|enum|typedef|const|volatile|static|extern|register|inline|restrict|return|case|goto|else|do|sizeof|typeof|alignof|if|while|for|switch|break|continue|default)\\s+[A-Za-z_]\\w*\\s+))(?<!\\b(?:struct|union|enum|typedef|const|volatile|static|extern|register|inline|restrict|return|case|goto|else|do|sizeof|typeof|alignof|if|while|for|switch|break|continue|default|void|char|short|int|long|float|double|signed|unsigned|_Bool|bool|u?int(?:8|16|32|64|ptr)_t|s?size_t)\\s+)\\b(ro|wo|w1c)\\b(?=\\s*[;,])",
      "captures": {
        "1": {
          "name": "storage.modifier.register.yasc.c"
        }
      }
    },
    "c23": {
      "$comment": "C23 / GNU words tcc takes that VSCode's C grammar does not know",
      "patterns": [
        {
          "match": "(?<!\\.|->)\\bconstexpr\\b",
          "name": "storage.modifier.constexpr.yasc.c"
        },
        {
          "match": "(?<!\\.|->)\\bnullptr\\b",
          "name": "constant.language.nullptr.yasc.c"
        },
        {
          "match": "(?<!\\.|->)\\b(?:typeof_unqual|typeof|__typeof__|__typeof|alignof)\\b(?=\\s*\\()",
          "name": "keyword.operator.typeof.yasc.c"
        },
        {
          "match": "(?<!\\.|->)\\b(?:__auto_type|auto)\\b",
          "name": "storage.type.auto.yasc.c"
        }
      ]
    },
    "qualifier-in-brackets": {
      "$comment": "a parameter array's outermost brackets qualify the pointer it becomes, as C99's a[const]: char * view argv[owned], int a[maybe 4], char * view a[view restrict]",
      "match": "(?<=\\b[A-Za-z_]\\w*\\s*\\[(?:\\s*(?:owned|view|maybe|restrict|const|volatile|static)\\b)*\\s*)(owned|view|maybe)\\b(?=[\\s\\w]*\\])",
      "name": "storage.modifier.yasc.c"
    },
    "at-builtin": {
      "comment": "@min / @max: tinycc's short builtins, in plain C files too",
      "match": "(@)(min|max)\\b(?=\\s*\\()",
      "name": "support.function.builtin.yasc.c",
      "captures": {
        "1": {
          "name": "punctuation.definition.builtin.yasc.c"
        }
      }
    },
    "slice-type": {
      "$comment": "[]T / [:0]T / [][]T: a slice prefix goes before the type, as !T. A '[' that follows a name, ')' or ']' indexes (int a[] __attribute__((x))), except after a storage-class word (static []const char s)",
      "patterns": [
        {
          "match": "(?<![\\w)\\]\\\"']\\s*)((?:\\[\\s*(?::\\s*0\\s*)?\\]\\s*)+)(?=[A-Za-z_])",
          "captures": {
            "1": {
              "name": "storage.modifier.slice.yasc.c"
            }
          }
        },
        {
          "match": "(?<=\\b(?:static|extern|register|typedef|inline|auto|constexpr|_Thread_local|thread_local)\\s+)((?:\\[\\s*(?::\\s*0\\s*)?\\]\\s*)+)(?=[A-Za-z_])",
          "captures": {
            "1": {
              "name": "storage.modifier.slice.yasc.c"
            }
          }
        }
      ]
    },
    "slice-colon": {
      "$comment": "x[a:b], x[a:], x[:b], x[a:b:0]: a ':' inside one pair of brackets with no '?' there (a[c ? 1 : 2] is a conditional) no quote (case '[': ... ']') and not '::' ([[gnu::unused]])",
      "match": "(?<=\\[[^\\[\\]?;{}'\\\"]*)(?<!:)(:)(?!:)(?=[^\\[\\]?;{}'\\\"]*\\])",
      "name": "keyword.operator.slice.yasc.c"
    },
    "cast": {
      "$comment": "cast<PERMISSION(TYPE), MODIFIER, ...>(EXPR) and unsafe_cast<...>(EXPR): the word, its '<' '>' and the permissions (int/float/enum there are permissions, the type in their parentheses stays C). Only when a permission follows the '<': cast < 3 compares a variable; one line only",
      "patterns": [
        {
          "match": "(?<!\\.|->)\\b(?:(unsafe_cast)|(cast))\\s*(<)(?=\\s*(?:as|int|trunc|bits|float|enum|ptr|align|addr|qual|const|fn)\\s*[(,>])",
          "captures": {
            "1": {
              "name": "keyword.operator.cast.unsafe.yasc.c"
            },
            "2": {
              "name": "keyword.operator.cast.yasc.c"
            },
            "3": {
              "name": "punctuation.definition.cast.begin.yasc.c"
            }
          }
        },
        {
          "match": "(?<=\\b(?:unsafe_)?cast\\s*<\\s*|\\b(?:unsafe_)?cast\\s*<[^<>;{}\\\"']*,\\s*)(?:as|int|trunc|bits|float|enum|ptr|align|addr|qual|const|fn)\\b(?=\\s*[(,>])",
          "name": "storage.modifier.cast.yasc.c"
        },
        {
          "match": "(?<=\\b(?:unsafe_)?cast\\s*<\\s*(?:as|int|trunc|bits|float|enum|ptr|align|addr|qual|const|fn)\\s*(?:[(,][^<>;{}\\\"']*)?)(?<!-)>",
          "name": "punctuation.definition.cast.end.yasc.c"
        }
      ]
    }
  }
}
